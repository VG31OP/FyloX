// Version information of the Explorer context-menu DLL. build/build-explorer-menu.ps1 passes the app version as
// FYLOX_VERSION_MAJOR/MINOR/PATCH and FYLOX_VERSION_TEXT.

#include <winver.h>

#ifndef FYLOX_VERSION_MAJOR
#define FYLOX_VERSION_MAJOR 0
#define FYLOX_VERSION_MINOR 0
#define FYLOX_VERSION_PATCH 0
#define FYLOX_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION FYLOX_VERSION_MAJOR, FYLOX_VERSION_MINOR, FYLOX_VERSION_PATCH, 0
PRODUCTVERSION FYLOX_VERSION_MAJOR, FYLOX_VERSION_MINOR, FYLOX_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FyloX contributors"
            VALUE "FileDescription", "FyloX File Explorer context menu"
            VALUE "FileVersion", FYLOX_VERSION_TEXT
            VALUE "InternalName", "FyloXExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) FyloX contributors. MIT License."
            VALUE "OriginalFilename", "FyloXExplorerMenu.dll"
            VALUE "ProductName", "FyloX"
            VALUE "ProductVersion", FYLOX_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
